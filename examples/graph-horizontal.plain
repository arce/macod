#line 2
style rshadow
  box radius=10 sw=1.3 padx=14 pady=7 shadow=3
  arrow sw=1.5
#line 2
diagram graph-horizontal style=rshadow caption="graph direction=right, labels on the arrows and a cycle."
#line 1
  row gap=74 align=center
    col gap=30 align=center
      box a "Client"
    col gap=30 align=center
      box b "Server"
    col gap=30 align=center
      box c "Database"
      box d "Cache"
  a.right -> b.left elbow "query"
  b.right -> c.left elbow "reads"
  b.right -> d.left elbow
  c.top -> a.top elbow margin=30
