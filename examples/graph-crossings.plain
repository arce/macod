style silberschatz
  box radius=0 sw=1.3 padx=8 pady=4
  arrow sw=1.3 italic
#line 5
style oreilly
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 2
diagram graph-crossings caption="graph orders each level to reduce crossings."
#line 1
  col gap=40 align=center
    row gap=30 align=center
      box a "A" light
      box b "B" light
    row gap=30 align=center
      box d "D"
      box c "C"
      spacer _g1 w=30 h=0
    row gap=30 align=center
      box e "E"
  a.bottom -> d.top elbow
  a.bottom -> c.top elbow
  b.bottom -- _g1.top elbow
  _g1.bottom -> e.top elbow
  b.bottom -> c.top elbow
  c.bottom -> e.top elbow
