#line 2
style rounded
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 10
diagram github-light style=rounded theme=github-light caption="theme=github-light"
  row gap=44
    box a "Client" light
    box b "API" primary
    box c "Store" yellow
  a -> b label="HTTP"
  b -> c
