#line 2
style rounded
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 2
diagram tree style=rounded caption="tree: the hierarchy comes from the indentation."
#line 1
  col gap=36 align=center
    box root "System" light
    row gap=20 align=start
      col gap=36 align=center
        box a "Documents"
        row gap=20 align=start
          col gap=36 align=center
            box a1 "Reports"
          col gap=36 align=center
            box a2 "Letters"
      col gap=36 align=center
        box b "Images"
      col gap=36 align=center
        box c "Music"
        row gap=20 align=start
          col gap=36 align=center
            box c1 "Rock"
  a.bottom -> a1.top elbow
  a.bottom -> a2.top elbow
  root.bottom -> a.top elbow
  root.bottom -> b.top elbow
  c.bottom -> c1.top elbow
  root.bottom -> c.top elbow
