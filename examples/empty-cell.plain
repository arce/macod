#line 2
style boxed
  box radius=0 sw=1.3 padx=8 pady=4
  arrow sw=1.3 italic
#line 2
diagram empty-cell style=boxed caption="datatable: an empty cell is written with quotes."
#line 1
  grid cols=3 gap=0 align=stretch
    box "Product" sw=1 radius=0 light bold
    box "Stock" sw=1 radius=0 light bold
    box "Note" sw=1 radius=0 light bold
    box "Green tea" sw=1 radius=0
    box "12" sw=1 radius=0
    box "" sw=1 radius=0
    box "Coffee" sw=1 radius=0
    box "0" sw=1 radius=0
    box "sold out" sw=1 radius=0
    box "Honey" sw=1 radius=0
    box "5" sw=1 radius=0
    box "" sw=1 radius=0
