style silberschatz
  box radius=0 sw=1.3 padx=8 pady=4
  arrow sw=1.3 italic
#line 5
style oreilly
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 2
diagram arbol caption="tree: la jerarquía sale de la indentación."
#line 1
  col gap=36 align=center
    box raiz "Sistema" light
    row gap=20 align=start
      col gap=36 align=center
        box a "Documentos"
        row gap=20 align=start
          col gap=36 align=center
            box a1 "Informes"
          col gap=36 align=center
            box a2 "Cartas"
      col gap=36 align=center
        box b "Imágenes"
      col gap=36 align=center
        box c "Música"
        row gap=20 align=start
          col gap=36 align=center
            box c1 "Rock"
  a.bottom -> a1.top elbow
  a.bottom -> a2.top elbow
  raiz.bottom -> a.top elbow
  raiz.bottom -> b.top elbow
  c.bottom -> c1.top elbow
  raiz.bottom -> c.top elbow
