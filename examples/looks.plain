#line 2
style boxed
  box radius=0 sw=1.3 padx=8 pady=4
  arrow sw=1.3 italic
#line 2
style rounded
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 2
style flat
  box radius=0 sw=0 padx=12 pady=6
  arrow sw=1.5
#line 2
style shadow
  box radius=0 sw=1.3 padx=10 pady=5 shadow=3
  arrow sw=1.5
#line 2
style rshadow
  box radius=10 sw=1.3 padx=14 pady=7 shadow=3
  arrow sw=1.5
#line 2
style oval
  box radius=999 sw=1.3 padx=26 pady=12
  arrow sw=1.5
#line 15
diagram boxed style=boxed caption="style=boxed"
  row gap=44
    box a "Client" light
    box b "API" green
    box c "Store" yellow
  a -> b -> c
#line 15
diagram rounded style=rounded caption="style=rounded"
  row gap=44
    box a "Client" light
    box b "API" green
    box c "Store" yellow
  a -> b -> c
