style silberschatz
  box radius=0 sw=1.3 padx=8 pady=4
  arrow sw=1.3 italic
#line 5
style oreilly
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 2
diagram grafo-horizontal caption="graph direction=right, etiquetas en las flechas y un ciclo."
#line 1
  row gap=104 align=center
    col gap=30 align=center
      box a "Cliente"
    col gap=30 align=center
      box b "Servidor"
    col gap=30 align=center
      box c "Base de datos"
      box d "Caché"
  a.right -> b.left elbow "consulta"
  b.right -> c.left elbow "lee"
  b.right -> d.left elbow
  c.top -> a.top elbow margin=30
