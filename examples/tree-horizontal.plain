style silberschatz
  box radius=0 sw=1.3 padx=8 pady=4
  arrow sw=1.3 italic
#line 5
style oreilly
  box radius=8 sw=1.6 padx=14 pady=8
  arrow sw=2.5
#line 2
diagram tree-horizontal caption="tree direction=right"
#line 1
  row gap=36 align=center
    box root "System" light
    col gap=20 align=start
      row gap=36 align=center
        box a "Documents"
        col gap=20 align=start
          row gap=36 align=center
            box a1 "Reports"
          row gap=36 align=center
            box a2 "Letters"
      row gap=36 align=center
        box b "Images"
  a.right -> a1.left elbow
  a.right -> a2.left elbow
  root.right -> a.left elbow
  root.right -> b.left elbow
